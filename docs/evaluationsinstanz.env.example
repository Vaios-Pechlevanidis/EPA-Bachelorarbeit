# Beispiel-Einstellungen der Evaluationsinstanz (DZ3), ohne Zugangsdaten.
# Erläuterung in docs/evaluationsinstanz.md. Diese Datei wird nicht eingelesen:
# die Backend-Zeilen nach backend/.env übernehmen (Vorlage backend/.env.example),
# die Frontend-Zeilen beim Bauen in der Shell setzen oder nach frontend/.env.local kopieren.

# ── Backend (backend/.env oder Umgebung des uvicorn-Prozesses) ─────────────────
SUPABASE_URL=https://<projekt>.supabase.co
# Lesender Schlüssel genügt; der Service-Key hat Vorrang, wenn beide gesetzt sind.
SUPABASE_KEY=<anon-key, nicht einchecken>
# SUPABASE_SERVICE_KEY=<nur falls nötig, nicht einchecken>
# Keine Live-Abrufe bei Yahoo Finance während der Interviews; nur der Zwischenspeicher
# backend/data/market/ (vorher mit scripts/fetch_market_data.py füllen, --summary prüfen).
MARKET_LIVE_FETCH=0
# Keine Abrufe externer Belege (Google News RSS, EQS) während der Interviews; nur der
# Belegspeicher backend/data/context/ (vorher mit scripts/fetch_context.py füllen).
CONTEXT_LIVE_FETCH=0
# GDELT als dritte Belegquelle bleibt aus.
# CONTEXT_GDELT=0
# Optional (Variable der Bibliothek transformers, nicht des Projekts): kein Netz zu Hugging Face;
# das Stimmungsmodell muss dann bereits im Cache liegen, sonst gilt der Lexikon-Modus.
# HF_HUB_OFFLINE=1

# ── Frontend (beim Bauen bzw. beim Start des Entwicklungsservers gelesen) ───────
VITE_API_URL=http://localhost:8000
# Entscheidung D3 (E16): false = Variante B ohne Zusatzkarten, true oder leer = Variante A.
VITE_SHOW_FINANCE_EXTRAS=false
